[node name="NPC_Mora" type="Node2D" parent="." unique_id=1681943075]
position = Vector2(-152, 1456)
script = ExtResource("15_fg7i4")
display_name = "Ing. Mora"
tile = Vector2i(24, 9)
lines = PackedStringArray("¡Bienvenido, especialista! Soy el ingeniero Mora. Antes de demoler un edificio, evalúalo con F: sabrás cuántos pisos tiene y qué tan lejos debes estar.", "Cada piso necesita una bomba. Colócalas junto al edificio con E y sal del círculo rojo antes de la última explosión.", "Revisa que no haya personas cerca. Si alguien está en la zona de peligro, habla con él para que se ponga a salvo.", "Y ojo: no todo edificio dañado se puede derribar. Si ves uno muy inclinado y agrietado, déjalo en pie y pide a un especialista.")
safe_path = PackedVector2Array()
reward_points = 15

[node name="NPC_Lucia" type="Node2D" parent="." unique_id=616503397]
position = Vector2(-232, 1484)
script = ExtResource("15_fg7i4")
display_name = "Vecina Lucía"
tile = Vector2i(24, 3)
lines = PackedStringArray("¡Gracias por venir! Mi casa se agrietó y tengo miedo de que se caiga. Me voy ahora mismo a la zona segura.", "Ya estoy a salvo. Gracias por avisarme antes de derribar el edificio.")
evacuable = true
safe_path = PackedVector2Array(-248, 1484, -248, 1548)
reward_points = 15

[node name="NPC_Mario" type="Node2D" parent="." unique_id=622670856]
position = Vector2(-72, 1484)
script = ExtResource("15_fg7i4")
display_name = "Don Mario"
tile = Vector2i(24, 12)
lines = PackedStringArray("Menos mal que llegó ayuda. Me alejo del edificio por la acera de abajo, lejos de los escombros.", "Estoy a salvo. Recuerde: nunca se acerque a un edificio dañado, puede caer sin aviso.")
evacuable = true
safe_path = PackedVector2Array(-72, 1548)
reward_points = 15

[node name="NPC_Andres" type="Node2D" parent="." unique_id=1188701657]
position = Vector2(24, 1484)
script = ExtResource("15_fg7i4")
display_name = "Vecino Andrés"
lines = PackedStringArray("Escuché crujidos en ese edificio de tres pisos. ¡Voy a ponerme a salvo ya mismo!", "Ya estoy lejos. Cuanto más alto es el edificio, más lejos hay que estar cuando cae.")
evacuable = true
safe_path = PackedVector2Array(24, 1548)
reward_points = 15

[node name="NPC_Rojas" type="Node2D" parent="." unique_id=1277354060]
position = Vector2(152, 1472)
script = ExtResource("15_fg7i4")
display_name = "Inspectora Rojas"
tile = Vector2i(24, 6)
lines = PackedStringArray("Ese edificio inclinado tiene la estructura comprometida: está agrietado y se ladea. No lo toques.", "Demolerlo sin un estudio especializado podría arrastrar a los vecinos. Evalúalo con F y déjalo en pie.", "En una emergencia real, solo personal capacitado decide qué se demuele.")
safe_path = PackedVector2Array()
reward_points = 15

